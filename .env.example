# Ghost Scribe Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# HuggingFace token for speaker diarization (required for the WhisperX engine's diarization step)
# Get yours at: https://huggingface.co/settings/tokens
# You must also accept the pyannote model terms:
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=

# OpenAI API key (required only for the OpenAI gpt-4o-transcribe-diarize engine)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Server port (default: 3001)
PORT=3001

# Basic HTTP auth password (leave empty to disable authentication)
AUTH_PASSWORD=
